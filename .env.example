# Modo de operação do frontend:
# - "mock" (padrão): funciona 100% standalone no navegador com dados locais (sem precisar do backend)
# - "api": conecta na API Principal Java (:8081) e no Microserviço de IA (:8082)
VITE_API_MODE=mock

# URL base da API Principal FinTrack (Java / Spring Boot)
VITE_API_BASE_URL=http://localhost:8081

# URL base do Microserviço de IA FinTrack (LangChain4j)
VITE_AI_API_BASE_URL=http://localhost:8082
